{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "allowSyntheticDefaultImports": true,
    "strict": true,

    "types": ["node"],

    "outDir": "./node_modules/.tmp/tsconfig-node",

    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true
  },

  "include": ["vite.config.ts"],

  "exclude": ["node_modules"]
}